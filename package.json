{
  "name": "pannes-historiques",
  "version": "0.4.8",
  "private": true,
  "type": "module",
  "scripts": {
    "assets:version": "node scripts/maintenance/browser-asset-version.mjs",
    "assets:version:check": "node scripts/maintenance/browser-asset-version.mjs --check",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "cf:status": "wrangler containers list",
    "format": "biome format --write app/static src scripts/maintenance && npm run assets:version",
    "lint": "biome lint app/static src scripts/maintenance",
    "check": "biome check app/static src scripts/maintenance && npm run assets:version:check",
    "test:unit": "node --test tests/*.test.js",
    "test": "npm run check && npm run test:unit",
    "audit:live-ui": "node scripts/maintenance/live-ui-audit.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:mobile": "playwright test --project=mobile-chromium"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@cloudflare/containers": "^0.3.7",
    "@playwright/test": "^1.62.1",
    "wrangler": "^4.117.0"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "maplibre-gl": "^6.1.0",
    "topojson-client": "^3.1.0",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3"
  },
  "overrides": {
    "undici": "^7.29.0"
  }
}
